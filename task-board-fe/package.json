{
  "name": "react-task-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "TASK_BOARD_USE_MOCK_API=true vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && prettier . --check",
    "format": "prettier . --write",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsc -p tsconfig.unit.json && node --test /tmp/react-task-board-unit/tests/unit/*.test.js && vitest run",
    "test:coverage": "tsc -p tsconfig.unit.json && node --experimental-test-coverage --test-coverage-lines=90 --test /tmp/react-task-board-unit/tests/unit/*.test.js && vitest run --coverage",
    "test:coverage:changed": "node scripts/verify-changed-coverage.mjs",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config playwright.integration.config.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "sass": "^1.102.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
